	<diagram_group name="Default" id="875a924c-d01c-44a8-96f5-37dfdc5b1cb8" >
		<diagram name="Default Diagram" id="ef760e1a-a5f7-41c2-a50b-ba9d35a2bae3" show_relation="columns" >
			<entity schema="Kolompok C UT" name="mitras : smkmuh4 &amp; smanmojo" color="3986C1" x="342" y="57" />
			<entity schema="Kolompok C UT" name="products" color="3986C1" x="1235" y="380" />
			<entity schema="Kolompok C UT" name="returns" color="3986C1" x="57" y="323" />
			<entity schema="Kolompok C UT" name="sale_items" color="3986C1" x="342" y="380" />
			<entity schema="Kolompok C UT" name="sales" color="3986C1" x="931" y="380" />
			<entity schema="Kolompok C UT" name="stock_transactions" color="3986C1" x="627" y="380" />
			<entity schema="Kolompok C UT" name="suplier : Kedai Primadona" color="3986C1" x="627" y="57" />
			<entity schema="Kolompok C UT" name="supplier_mitra_products" color="3986C1" x="285" y="703" />
			<entity schema="Kolompok C UT" name="users" color="3986C1" x="1539" y="380" />
			<script name="AI" id="42871208-90ad-4c12-82dc-aa24832e5d4e" language="SQL" confirmed="y" >
				<string><![CDATA[SELECT
st.trx_date,
m.mitra_name,
p.product_name,
SUM(CASE WHEN st.trx_type = 'IN'     THEN st.quantity ELSE 0 END) AS qty_titip,
SUM(CASE WHEN st.trx_type = 'SALE'   THEN st.quantity ELSE 0 END) AS qty_terjual,
SUM(CASE WHEN st.trx_type = 'RETURN' THEN st.quantity ELSE 0 END) AS qty_kembali
FROM stock_transactions st
JOIN products p ON p.product_id = st.product_id
JOIN mitras m   ON m.mitra_id = st.mitra_id
WHERE p.supplier_id = 1  -- misal Kedai Primadona
AND st.trx_date = '2026-10-19'
GROUP BY st.trx_date, m.mitra_name, p.product_name;]]></string>
			</script>
		</diagram>
	</diagram_group>
</project>